# Copy to .env and fill in your own values. Never commit the real .env.
# Database selector: "mysql" or "db" (SQLite fallback)
DATABASE=mysql

GREENHOUSE_MYSQL_USER=your_mysql_username
GREENHOUSE_MYSQL_PWD=your_mysql_password
GREENHOUSE_MYSQL_HOST=your_mysql_host
GREENHOUSE_MYSQL_DB=your_mysql_database
GREENHOUSE_MYSQL_PORT=3306
